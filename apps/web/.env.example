# ─── Stripe ───────────────────────────────────────────────────
# Get these at https://dashboard.stripe.com/apikeys
# Use test keys (sk_test_..., pk_test_...) while developing.

STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Publishable key (safe to expose to the browser)
PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# ─── Stripe Price IDs ─────────────────────────────────────────
# Create products in the Stripe Dashboard → Products → Add product.
# Copy each Price ID (price_...) here.

STRIPE_PRICE_ID_SINGLE=price_REPLACE_ME
STRIPE_PRICE_ID_BUNDLE=price_REPLACE_ME
STRIPE_PRICE_ID_MONTHLY=price_REPLACE_ME

# ─── Optional: Email notifications (Resend) ───────────────────
# Sign up at https://resend.com — free tier handles up to 3 000 emails/mo.
# RESEND_API_KEY=re_REPLACE_ME

# ─── Supabase (required for native scheduling) ────────────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
